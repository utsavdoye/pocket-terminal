{
  "name": "pocket-terminal",
  "version": "7.0.2",
  "description": "Your computer's terminal on your phone, from anywhere, even with the lid closed. Run AI agents, get notified, open localhost. Direct and end-to-end encrypted.",
  "bin": {
    "pocket-terminal": "cli.js"
  },
  "files": [
    "cli.js",
    "agent/",
    "!agent/test/",
    "!agent/node_modules/",
    "!agent/*.log"
  ],
  "engines": {
    "node": ">=18.20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "terminal",
    "remote",
    "phone",
    "mobile",
    "ssh",
    "webrtc",
    "p2p",
    "claude-code",
    "ai-agent",
    "localhost",
    "pwa",
    "end-to-end-encryption"
  ],
  "homepage": "https://pocket-terminal.utsavdoye.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utsavdoye/pocket-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/utsavdoye/pocket-terminal/issues"
  },
  "author": "Utsav Doye (https://pocket-terminal.utsavdoye.com)",
  "license": "MIT"
}
